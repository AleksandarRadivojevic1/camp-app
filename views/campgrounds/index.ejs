<% layout('layouts/boilerplate') %>
<% block('head').append('<script src="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.js"></script><link href="https://api.mapbox.com/mapbox-gl-js/v3.17.0/mapbox-gl.css" rel="stylesheet" />') %>

<div id="cluster-map"></div>

<div class="page-header">
  <h1>Campgrounds</h1>
  <a href="/campgrounds/new" class="btn btn-primary">Add Campground</a>
</div>

<div class="camp-grid">
  <% for (let campground of campgrounds) { %>
  <article class="camp-card">
    <a href="/campgrounds/<%= campground._id %>" class="camp-card__link">
      <figure class="camp-card__figure">
        <% if (campground.images.length) { %>
          <img src="<%= campground.images[0].url %>" alt="<%= campground.title %>" class="camp-card__img" loading="lazy">
        <% } else { %>
          <img src="https://placehold.co/600x400/d4c2a8/5a3e28?text=No+Photo" class="camp-card__img" alt="No photo available" loading="lazy">
        <% } %>
      </figure>
      <div class="camp-card__body">
        <p class="camp-card__meta"><%= campground.location %></p>
        <h2 class="camp-card__title"><%= campground.title %></h2>
        <p class="camp-card__desc"><%= campground.description %></p>
        <span class="camp-card__cta">View campground &rarr;</span>
      </div>
    </a>
  </article>
  <% } %>
</div>

<script>
  const mapToken = '<%-process.env.MAPBOX_TOKEN%>'
  const campgrounds = { features: <%-JSON.stringify(campgrounds)%> }
</script>
<script src="/javascripts/clusterMap.js"></script>
