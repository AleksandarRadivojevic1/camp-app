<% layout('layouts/boilerplate') %>

<div class="error-page">
  <p class="error-page__code">Error <%= err.statusCode || 500 %></p>
  <h1 class="error-page__message"><%= err.message %></h1>
  <% if(process.env.NODE_ENV !== "production"){ %>
  <pre class="error-page__stack"><%= err.stack %></pre>
  <% } %>
  <a class="btn-back" href="/campgrounds">&#8592; Back to Campgrounds</a>
</div>
